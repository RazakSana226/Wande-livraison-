# WÀNDÉ Web Application - Environment Variables Example
# Duplicate this file to .env or configure in your CI/CD / GitHub Secrets

# Firebase Web SDK Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Maps JavaScript API Key (Used if provided, otherwise high-performance OpenStreetMap / Leaflet tiles are used seamlessly)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_optional

# Base path for deployment (Default is './' for GitHub Pages subfolder compatibility)
VITE_BASE_PATH=./
